// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.
enum Role {
  // Block keys and attributes
  OWNER
  MANAGER
  COOK
  WAITER
}

model User {
  id        String   @id @onCreate(uuid())
  email     String   @unique
  password  String
  role      Role     @default(WAITER)
  createdAt DateTime @onCreate(now()) @map("created_at")
  updatedAt DateTime @onUpdate(now()) @map("updated_at")
  profile   Profile?

  @@map("users")
}

model Profile {
  id           String   @id @onCreate(uuid())
  userId       String   @unique @map("user_id")
  name         String
  profileImage String?  @map("profile_image")
  createdAt    DateTime @onCreate(now()) @map("created_at")
  updatedAt    DateTime @onUpdate(now()) @map("updated_at")
  user         User     @relation(fields: [userId], references: [id])

  @@map("profiles")
}
